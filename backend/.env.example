# =============================================================================
# Planning H&S — environment configuration example
#
# Copy this file to "backend/.env" and fill in real values only in your
# local copy. Never commit the real ".env" file: it is already excluded
# via .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Local development: SQLite (default, no setup required)
DATABASE_URL=sqlite+aiosqlite:///./planning_hs.db

# Production / cloud: PostgreSQL (e.g. Railway, Render, Supabase)
# Uncomment and replace with real credentials when deploying.
# DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Planning H&S
DEBUG=True

# -----------------------------------------------------------------------------
# Settings encryption key (required to store the SMTP password persistently)
#
# The SMTP password entered from the Settings page is encrypted before being
# saved to the database, and decrypted only in memory when the app needs to
# send an email. This key is what makes that encryption possible.
#
# Generate one locally (with the backend virtual environment active) and
# paste the output below. Do this once per installation:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# If this key is missing, the app still works normally, but any SMTP
# password saved from the Settings page will not survive a backend restart.
# Keep this key secret: anyone who has it, plus access to the database file,
# can decrypt the stored SMTP password.
# -----------------------------------------------------------------------------
SETTINGS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email notifications (SMTP) — optional initial values
#
# These are only used to seed the application settings the first time the
# app starts with an empty database. After that, the values actually used
# live in the database and are managed from the Settings page in the UI.
#
# Leave these empty if you don't want to send emails. The app works fine
# without SMTP configured — it just won't send alert summaries.
#
# Security: never use your main account password here. Use a dedicated
# app password or SMTP credential (supported by Gmail, Outlook, iCloud,
# and most providers). It can be revoked at any time without affecting
# your main account.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Planning H&S

# Recipient of the daily aggregated change report (e.g. HR / RSPP)
REPORT_RECIPIENT_EMAIL=

# -----------------------------------------------------------------------------
# Alert thresholds, in days
#
# A course or medical fitness check is flagged "expiring soon" when its
# remaining days fall below ALERT_EXPIRING_SOON_DAYS, and "critical" when
# they fall to or below ALERT_CRITICAL_DAYS. The same thresholds are used
# to decide when to send an email alert. Also editable from Settings.
# -----------------------------------------------------------------------------
ALERT_EXPIRING_SOON_DAYS=70
ALERT_CRITICAL_DAYS=0

# -----------------------------------------------------------------------------
# Reports
# -----------------------------------------------------------------------------

# Default day window used by the Reports page when no filter is applied
REPORT_DAYS_THRESHOLD=150

# -----------------------------------------------------------------------------
# Scheduler
#
# Hour/minute (server local time, 24h format) at which the automatic daily
# check runs. It looks for changes since the previous run (new missing
# course, course gone from OK to expiring/critical, etc.) and sends a single
# summary email only if something changed. Also editable from Settings.
# -----------------------------------------------------------------------------
DAILY_CHECK_HOUR=6
DAILY_CHECK_MINUTE=0